<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="widget_desc">See how your cat is feeling at a glance.</string>
    <string name="widget_cat">Your cat</string>
    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="WidgetLabel">
        <item name="android:layout_width">54dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#5B3A4A</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="WidgetBar" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">8dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:max">100</item>
        <item name="android:progressDrawable">@drawable/widget_bar</item>
    </style>
</resources>
